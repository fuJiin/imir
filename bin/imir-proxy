#!/bin/bash
# imir-proxy — install Caddy and configure it as a reverse proxy.
# Idempotent: safe to re-run.
set -euo pipefail

ROUTES=""
EMAIL=""

while [[ $# -gt 0 ]]; do
    case "$1" in
        --route|--routes)
            ROUTES="${2:-}"
            shift 2
            ;;
        --route=*|--routes=*)
            ROUTES="${1#*=}"
            shift
            ;;
        --email)
            EMAIL="${2:-}"
            shift 2
            ;;
        --email=*)
            EMAIL="${1#*=}"
            shift
            ;;
        *)
            echo "Error: unknown argument '$1'." >&2
            echo "Usage: imir-proxy --route HOST=PORT[,HOST=PORT...] [--email <addr>]" >&2
            exit 1
            ;;
    esac
done

if [[ "${EUID:-$(id -u)}" -ne 0 ]]; then
    echo "Error: imir-proxy must run as root (use sudo)." >&2
    exit 1
fi

if [[ -z "$ROUTES" ]]; then
    echo "Error: --route is required (e.g. crew.example.com=7842)." >&2
    exit 1
fi

echo "=== imir proxy ==="

# ── Install Caddy from official apt repo ──────────────────────────
if ! command -v caddy &>/dev/null; then
    echo "→ Installing Caddy..."
    export DEBIAN_FRONTEND=noninteractive
    apt-get update -qq
    apt-get install -y debian-keyring debian-archive-keyring apt-transport-https curl gpg

    if [[ ! -f /usr/share/keyrings/caddy-stable-archive-keyring.gpg ]]; then
        curl -1sLf 'https://dl.cloudsmith.io/public/caddy/stable/gpg.key' \
            | gpg --dearmor -o /usr/share/keyrings/caddy-stable-archive-keyring.gpg
    fi
    if [[ ! -f /etc/apt/sources.list.d/caddy-stable.list ]]; then
        curl -1sLf 'https://dl.cloudsmith.io/public/caddy/stable/debian.deb.txt' \
            > /etc/apt/sources.list.d/caddy-stable.list
    fi
    apt-get update -qq
    apt-get install -y caddy
fi

# ── Generate Caddyfile from --route ────────────────────────────────
echo "→ Writing /etc/caddy/Caddyfile..."
TMPFILE=$(mktemp)
trap 'rm -f "$TMPFILE"' EXIT

{
    echo "# Managed by imir-proxy. Re-run \`imir proxy\` to refresh."
    echo
    echo "{"
    echo "    acme_ca https://acme-v02.api.letsencrypt.org/directory"
    if [[ -n "$EMAIL" ]]; then
        echo "    email $EMAIL"
    fi
    echo "}"
    echo
} > "$TMPFILE"

IFS=',' read -ra route_list <<< "$ROUTES"
for r in "${route_list[@]}"; do
    r="${r// /}"
    [[ -z "$r" ]] && continue
    if [[ "$r" != *=* ]]; then
        echo "Error: route '$r' must be HOST=PORT." >&2
        exit 1
    fi
    host="${r%%=*}"
    port="${r##*=}"
    if [[ ! "$port" =~ ^[0-9]+$ ]]; then
        echo "Error: invalid port '$port' in route '$r'." >&2
        exit 1
    fi
    {
        echo "$host {"
        echo "    log {"
        echo "        format json"
        echo "    }"
        echo "    reverse_proxy localhost:$port"
        echo "}"
        echo
    } >> "$TMPFILE"
    echo "  Route: $host → localhost:$port"
done

# ── Validate before installing ────────────────────────────────────
caddy validate --config "$TMPFILE" --adapter caddyfile
install -m 644 "$TMPFILE" /etc/caddy/Caddyfile

# ── Reload Caddy ──────────────────────────────────────────────────
systemctl enable --now caddy >/dev/null
systemctl reload caddy

echo
echo "=== Caddy reloaded ==="
systemctl --no-pager --lines=0 status caddy | head -5
